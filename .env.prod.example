# ============================================================
#  生产环境配置模板（部署到服务器后 cp .env.prod.example .env 再改）
#  红线：.env 绝不入库（.gitignore 已排除）；禁止硬编码进代码/镜像
# ============================================================

# ==== 基础 ====
APP_ENV=production
# ⚠️ 生产必须为 false（true 时 LLM 走确定性 mock，对外就是假答案）
MOCK_MODE=false
PROVINCE=guangdong
CURRENT_YEAR=2026
REF_YEARS=2024,2025,2026
YEAR_WEIGHTS=0.2,0.3,0.5
TIER_MIN_RANK_BASIS=500

# ==== MySQL / Redis（容器内由 compose 覆盖，这里填一致的值即可）====
# ⚠️ 密码必须与 MYSQL_ROOT_PASSWORD 一致；生产请改成强密码
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PWD
MYSQL_DATABASE=gaokao
DATABASE_URL=mysql+pymysql://root:CHANGE_ME_STRONG_PWD@mysql:3306/gaokao?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
TEST_DATABASE_URL=

# ==== 首次灌数据开关 ====
# 首次部署置 1（自动跑 import_data.py，幂等）；导入完成后改回 0
IMPORT_DATA=1

# ==== LLM（OpenAI 兼容 · 多模型可切换）====
LLM_MODEL=deepseek-v4-flash
LLM_MODELS=deepseek-v4-flash,qwen-plus,glm-4-flash
LLM_BASE_URLS=https://api.deepseek.com/v1,https://dashscope.aliyuncs.com/compatible-mode/v1,https://open.bigmodel.cn/api/paas/v4
# ⚠️ 与 LLM_MODELS 顺序一一对应；不用的留空（会自动跳过）；全空时走专家规则模式
LLM_API_KEYS=,,
LLM_DISABLE_THINKING=true
LLM_TIMEOUT=30
LLM_MAX_RETRIES=1
LLM_EMBED_MODEL=bge-m3
LLM_RERANK_MODEL=bge-reranker-v2-m3

# ==== 安全（部署前用 openssl rand -hex 32 生成替换）====
SCORE_HASH_SALT=CHANGE_ME_RANDOM_32
AUTH_SECRET=CHANGE_ME_RANDOM_32
ADMIN_TOKEN=CHANGE_ME_RANDOM_16
AUTH_TOKEN_TTL_HOURS=24

# ==== 限流（公网部署：白名单留空）====
RATE_LIMIT_IP_PER_MIN=60
RATE_LIMIT_IP_PER_DAY=1000
RATE_LIMIT_SESSION_PER_MIN=30
RATE_LIMIT_SESSION_PER_DAY=500
RATE_LIMIT_SSE_CONCURRENT=3
RATE_LIMIT_SSE_MAX_SECONDS=300
RATE_LIMIT_RETRY_AFTER=60
# ⚠️ 公网部署不要放行任何 IP；如需管理豁免用 TOKEN
RATE_LIMIT_WHITELIST_IPS=
RATE_LIMIT_WHITELIST_TOKENS=

# ---- 注册/登录防滥用（T33）----
# 单 IP 注册上限（次/小时 与 次/天）——防脚本批量建号
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_REGISTER_PER_DAY=20
# 单 IP 登录失败上限（次/小时）——防撞库爆破，超限直接拒绝登录
RATE_LIMIT_LOGIN_FAIL_PER_HOUR=20
# 单 IP 验证码签发上限（次/小时）——防无限取码后暴力枚举
RATE_LIMIT_CAPTCHA_PER_HOUR=60
# 图形验证码开关（本地联调可设 false）与有效期（秒）
CAPTCHA_ENABLED=true
CAPTCHA_TTL_SECONDS=300
# 前端与 API 同源（8081），此处仅为直接访问后端时兜底
CORS_ORIGINS=http://39.107.44.42:8081

# ==== 日志 ====
LOG_LEVEL=INFO
DEBUG=false
