# ============================================================
#  高考升学志愿填报 AI 助手 · 配置模板
#  用法：cp .env.example .env  然后按本机实际情况修改
#  红线：.env 绝不入库（已在 .gitignore 排除）；禁止硬编码到代码
# ============================================================

# ==== 基础配置 ====
APP_ENV=development
# 演示省份（当前只做广东，新高考 3+1+2）
PROVINCE=guangdong
# 「当年」——推荐只使用 <= CURRENT_YEAR 的数据
CURRENT_YEAR=2026
# 参考年份（冲稳保三年加权用），**从旧到新**，逗号分隔（口径见 data_caliber §1.1）
REF_YEARS=2024,2025,2026
# 年份权重（与 REF_YEARS 一一对应，从旧到新），和必须为 1；越近权重越高
YEAR_WEIGHTS=0.2,0.3,0.5
# 极高位次分档保护：位次小于该值时按该值计算冲稳保边界
TIER_MIN_RANK_BASIS=500
# 离线联调开关：true 时 LLM 走确定性 mock，无需 API key 即可跑通全链路
# ⚠️ 生产/对外演示必须为 false（走真实模型链；全部模型不可用时自动降级专家规则模式）
MOCK_MODE=true

# ==== 数据库（MySQL 8）====
# 本机已有 MySQL80（3306），直接复用；库名 gaokao，字符集 utf8mb4
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/gaokao?charset=utf8mb4
# 可选：pytest 使用的独立测试库；设置后测试会自动覆盖 DATABASE_URL，
# 防止导入/迁移类测试触碰开发库。示例：
# TEST_DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/gaokao_test?charset=utf8mb4
TEST_DATABASE_URL=

# ==== Redis 7 ====
# 本机 Redis 走 Docker 容器，映射 6380（避开 6379 潜在冲突）
REDIS_URL=redis://127.0.0.1:6380/0

# ==== Docker Compose 专用（compose 文件引用；纯本机开发可忽略）====
# MySQL 容器 root 密码（compose 的 mysql 服务与 api 的容器内 DATABASE_URL 共用）
MYSQL_ROOT_PASSWORD=123456
# MySQL 容器初始库名（初始化脚本建同名库，utf8mb4）
MYSQL_DATABASE=gaokao
# 首次灌数据开关：api 容器启动时 IMPORT_DATA=1 → 自动跑 scripts/import_data.py（幂等）。
# 前提：仓库 data/cleaned 下已有 CSV（compose 已挂载只读卷）。日常重启保持 0。
IMPORT_DATA=0

# ==== LLM（OpenAI 兼容 · 多模型可切换）====
# 默认主模型
LLM_MODEL=deepseek-v4-flash
# 降级链：主模型超时/5xx/停服/欠费时，按顺序自动切下一个（防单模型停服）
LLM_MODELS=deepseek-v4-flash,qwen-plus,glm-4-flash
# 与上面模型一一对应的 base_url（顺序必须严格一致）
LLM_BASE_URLS=https://api.deepseek.com/v1,https://dashscope.aliyuncs.com/compatible-mode/v1,https://open.bigmodel.cn/api/paas/v4
# 与上面模型一一对应的 API Key（顺序必须严格一致；留空表示该模型不可用，会自动跳过）
LLM_API_KEYS=,,
# DeepSeek 思考型模型可在低 token 预算下只返回 reasoning_content；默认关闭思考，
# 仅对 DeepSeek 官方接口生效，切换其他 OpenAI 兼容模型时不会注入该参数。
LLM_DISABLE_THINKING=true
# 单次请求超时（秒）与最大重试
LLM_TIMEOUT=30
LLM_MAX_RETRIES=1
# RAG 用（T13；可空缺，缺省退化为关键词匹配）
LLM_EMBED_MODEL=bge-m3
LLM_RERANK_MODEL=bge-reranker-v2-m3

# ==== 安全 ====
# 敏感字段（分数/位次）落库哈希盐值，生产必须修改
SCORE_HASH_SALT=change-me-in-production
# 管理后台 Token（T24 起用）
ADMIN_TOKEN=change-me
# 登录令牌签名密钥与有效期（生产必须修改）
AUTH_SECRET=change-me-auth-secret
AUTH_TOKEN_TTL_HOURS=24

# ==== 限流（T20）====
# 频率窗口：每 IP / 每会话的「分钟」与「每日」上限（分钟窗口先触发）
RATE_LIMIT_IP_PER_MIN=60
RATE_LIMIT_IP_PER_DAY=1000
RATE_LIMIT_SESSION_PER_MIN=30
RATE_LIMIT_SESSION_PER_DAY=500
# SSE 长连接：单 IP / 单会话的「并发连接数」上限（与请求频率是两个维度）
RATE_LIMIT_SSE_CONCURRENT=3
# SSE 连接最长存活秒数（超时强制收尾，防长连接耗尽）
RATE_LIMIT_SSE_MAX_SECONDS=300
# 触发限流时的 Retry-After（秒）
RATE_LIMIT_RETRY_AFTER=60
# 白名单：本地开发 IP / 管理 Token（逗号分隔，命中即不限流）
RATE_LIMIT_WHITELIST_IPS=127.0.0.1,::1
RATE_LIMIT_WHITELIST_TOKENS=
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5599,http://localhost:5599

# ==== 日志 ====
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
DEBUG=false
